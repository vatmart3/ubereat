# ── Supabase ─────────────────────────────────────────────────────────────
# Laisser vide pour lancer l'app en MODE DÉMO (données en mémoire, restaurant pré-rempli).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement (scellé, PIN, reçus publics, purge). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# ── Application ──────────────────────────────────────────────────────────
# URL publique (liens des reçus, sitemap, OG). Ex. https://remis.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret HMAC des cookies (appareil comptoir) — 32 caractères minimum : `openssl rand -base64 32`
REMIS_SECRET=
# Protège /api/cron/purge (Vercel l'envoie automatiquement en Bearer).
CRON_SECRET=

# ── Horodatage ───────────────────────────────────────────────────────────
# server (V1) | rfc3161 (à brancher sur une TSA qualifiée eIDAS — voir lib/seal/timestamp.ts)
TIMESTAMP_PROVIDER=server
TSA_URL=

# ── Seed (npm run seed) ──────────────────────────────────────────────────
# Connexion directe Postgres du projet Supabase (Settings → Database → Connection string, port 5432).
DATABASE_URL=
